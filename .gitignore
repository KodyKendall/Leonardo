# Rails storage - ignore contents but keep directory for proper ownership
rails/storage/*
!rails/storage/.gitkeep

# Backup logs
logs/

# Private prompts (version controlled separately)
prompts/

# SSH keys for VSCode container (generated by bin/install/setup-ssh-full.sh)
.ssh/

# Per-instance state (identity, backup target, update markers) — never tracked
.leonardo/instance.json
.leonardo/update.log
.leonardo/last_update.json
# Written by the box from the mothership's fleet model policy. It landed inside
# the tree root-owned 0600, which made `git add -A` abort with "unable to index
# file" — so Leo's automatic checkpoint commits silently stopped on every box
# that received a policy (AgentTask #255). LlamaBot now writes it 1000:1000 0644;
# it is still per-instance state and must never be tracked.
.leonardo/model_policy.json
docker-compose.yml.pre-sync-*
rails/public/uploads/*
!rails/public/uploads/.keep

# ── Agent & CLI credentials — NEVER commit (fleet rule, added 2026-08-24) ──
# Codex CLI runs with CODEX_HOME set INSIDE this repo, so the whole tree is ignored,
# not just auth.json (which holds OPENAI_API_KEY plus OAuth refresh tokens).
.leonardo/chatgpt-auth/
.codex/
auth.json
# Claude Code credentials
.claude/.credentials.json
.claude.json
# Generic credential stores
.netrc
.git-credentials
.config/gh/
.aws/
# Private keys and service credentials
.ssh-shared/
*.pem
*.ppk
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
service-account*.json
client_secret*.json
