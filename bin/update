#!/usr/bin/env bash
#
# bin/update — pull the platform allowlist from upstream + swap image versions, then restart.
#
# Invoked on the HOST (cwd = the Leonardo project dir) in two ways:
#   1. The "Update Now" banner: LlamaBot's POST /api/update runs
#        bash bin/update <llamabot_version> <llamapress_version>
#      on the host via its nsenter bridge (app/routers/slash_commands.py).
#   2. The mothership admin fleet-push (PushInstanceUpdateJob) over SSH.
#
# We deliberately NEVER `git merge`/`git pull` — user instances carry agent-edited code and a
# merge silently rewrites their app (auth, routes, home page have all been broken this way).
# Instead, updating is two safe channels:
#   * IMAGE  — set the new versions -> docker compose pull -> recreate the changed services.
#   * SYNC   — pull a small, explicit ALLOWLIST of platform paths WHOLESALE from upstream via
#              `git checkout upstream/main -- <allowlist>`. A path-scoped checkout only ever
#              touches paths that exist in upstream; client-only files (e.g. bin/local/) and the
#              app's own migrations are left intact. Anything NOT on the allowlist is the client's.
#              See docs/DISTRIBUTION.md. The allowlist starts tiny and grows deliberately —
#              a path qualifies ONLY if clients never hand-edit it (checkout clobbers local edits).
#
# `.gitignore` is UNION-merged (never overwritten) so client entries survive; `.leonardo/
# instance.json` is force-untracked (its drift once sent backups to the wrong bucket).
#
# The sync is committed, scoped to the synced paths only, and is skipped gracefully when there is
# no `upstream` remote (e.g. on the upstream repo itself) or the network is unavailable.
#
# Dual-mode version setting, auto-detected from docker-compose.yml (applied AFTER the sync so the
# fresh upstream compose keeps the intended tags):
#   * parametrized (image: ...:${LLAMABOT_VERSION:-X}) -> write the version into .env (gitignored)
#   * literal tag  (image: ...:X)                      -> rewrite the tag in docker-compose.yml
#
# Usage: bin/update <llamabot_version> <llamapress_version>
#        bin/update --sync-only            # pull the allowlist from upstream, no image swap
#
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
cd "$PROJECT_DIR" || { echo "bin/update: cannot cd to $PROJECT_DIR" >&2; exit 1; }

COMPOSE_FILE="docker-compose.yml"
OVERRIDE_FILE="docker-compose.override.yml"   # per-instance config; never synced (see seed_override_file)
ENV_FILE=".env"
MARKER_DIR=".leonardo"
MARKER="$MARKER_DIR/last_update.json"
LOG="$MARKER_DIR/update.log"

UPSTREAM_REMOTE="upstream"
UPSTREAM_BRANCH="main"

# The allowlist: platform paths pulled WHOLESALE from upstream (overwrite). Only ever add paths
# clients never hand-edit — a checkout clobbers local changes there. Trend this toward zero by
# moving paths into the image instead (see docs/DISTRIBUTION.md).
#
# v1 is deliberately the smallest self-sustaining set:
#   * bin               — platform tooling, incl. bin/update itself => the allowlist self-propagates
#                         (future additions ship themselves). bin/local/ is client-owned, never clobbered.
#   * rails/db/migrate  — new platform migrations (append-only; never collides with the app's own).
#   * langgraph/langgraph.json — the agent-graph registry. New platform agents are dead unless they're
#                         registered here, so it must track upstream wholesale. Caveat: a checkout
#                         clobbers local edits, so clients register their own graphs upstream rather
#                         than by hand-editing this file.
#   * docker-compose.yml — the service/mount definition. Platform changes here (new mounts, service
#                         wiring) must reach the fleet wholesale; the version tags are re-stamped
#                         AFTER the sync (see the ordering note by sync_from_upstream below), so
#                         upstream's default tags never stick. Clients never hand-edit compose —
#                         per-instance config lives in docker-compose.override.yml (auto-merged by
#                         docker compose, never synced). A pre-sync snapshot of the compose file is
#                         kept on-box (docker-compose.yml.pre-sync-*, last 3) as a safety net.
#   * rails/app/javascript/llamapress — platform JS helpers (feedback bubble, element selector,
#                         console capture, etc.). Platform-owned; downstream overrides belong in
#                         a different path, not hand-edits here — a sync overwrites wholesale.
# Phase-2 targets, added only AFTER a fleet divergence audit (each overwrites wholesale):
#   rails/app/views/layouts/_llamapress_page_context.html.erb
ALLOWLIST=(
  "bin"
  "rails/db/migrate"
  "langgraph/langgraph.json"
  "docker-compose.yml"
  "rails/app/javascript/llamapress"
)

# Client-overlay files: bind-mounted as FILES by docker-compose.yml (which IS allowlisted)
# but deliberately NOT allowlisted themselves — the client owns their contents (e.g. custom
# Leo modes in langgraph.local.json). A sync can therefore deliver a compose that mounts a
# file the client doesn't have yet; docker auto-creates the missing bind source as a
# root-owned DIRECTORY, and every `up` after that fails with runc's "not a directory" mount
# error. Each path here is seeded from upstream ONCE when missing (never overwritten after
# that), and an empty-directory wedge left behind by docker is healed in place.
# INVARIANT: any new file bind-mount added to docker-compose.yml upstream needs a matching
# entry here (or must ship inside the image) — see docs/DISTRIBUTION.md.
OVERLAY_SEEDS=(
  "langgraph/langgraph.local.json"
  "langgraph/agent_modes.json"
  "rails/config/initializers/devise.rb"
  "rails/config/initializers/llama_bot_rails.rb"
  "rails/config/initializers/session_cookie.rb"
  "rails/config/initializers/custom"
  "rails/config/locales"
  "rails/config/storage.yml"
  "rails/config/environments/test.rb"
  "rails/lib"
  "rails/public/uploads"
)

# The auto-commit guard (paths the sync may commit) is DERIVED from ALLOWLIST + the two
# special-cased files, so it can never drift from the list above. Matches a dir prefix or exact file.
build_sync_commit_re() {
  local p esc parts=()
  for p in "${ALLOWLIST[@]}" "${OVERLAY_SEEDS[@]}" "$OVERRIDE_FILE" ".gitignore" ".leonardo/instance.json"; do
    esc="${p//./\\.}"
    parts+=("${esc}(/|\$)")
  done
  local IFS='|'; printf '^(%s)' "${parts[*]}"
}
SYNC_COMMIT_RE="$(build_sync_commit_re)"

LLAMABOT_TARGET="${1:-}"
LLAMAPRESS_TARGET="${2:-}"
VERSION_RE='^[0-9A-Za-z.\-]+$'
CHANGED=()
COMPOSE_SYNC_CHANGED=0   # set by sync_from_upstream when the checkout altered docker-compose.yml

mkdir -p "$MARKER_DIR" 2>/dev/null || true

log() { echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] $*" | tee -a "$LOG" >&2; }

write_marker() { # $1 status  $2 message
  cat > "$MARKER" <<EOF
{
  "status": "$1",
  "message": "$2",
  "llamabot_target": "$LLAMABOT_TARGET",
  "llamapress_target": "$LLAMAPRESS_TARGET",
  "changed_services": "${CHANGED[*]:-}",
  "finished_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF
}

fail() { log "FAILED: $1"; write_marker "failed" "$1"; exit 1; }

# ---- platform sync (allowlist checkout from upstream) ----------------------
# Append every upstream .gitignore line the box does not already have. Two failure
# modes made this a silent no-op on a large slice of the fleet (mothership sweep,
# 2026-08-24), so both are handled and any append failure is now LOGGED:
#   * a .gitignore with no trailing newline glues the first appended line onto the
#     last existing one, breaking both rules;
#   * a root-owned .gitignore inside an ubuntu-owned repo rejects every append, and
#     the stderr went nowhere — 51 of 160 boxes could never take another rule.
gitignore_append() { # $1 file, $2 line — returns non-zero (and logs once) if unwritable
  printf '%s\n' "$2" >> "$1" && return 0
  [ -n "${_GI_WARNED:-}" ] || { log "gitignore: NOT WRITABLE ($1) — union skipped"; _GI_WARNED=1; }
  return 1
}

ensure_gitignore_union() { # $1 ref — append upstream .gitignore lines not already present
  local ref="$1" up line gi="$PROJECT_DIR/.gitignore" owner
  up="$(git -C "$PROJECT_DIR" show "$ref:.gitignore" 2>/dev/null)" || return 0
  touch "$gi" 2>/dev/null || { log "gitignore: NOT WRITABLE ($gi) — union skipped"; return 0; }
  _GI_WARNED=""

  # Keep ownership matching the repo root, or a later append by `ubuntu` fails and
  # the box is frozen out of every future rule.
  owner="$(stat -c %U "$PROJECT_DIR" 2>/dev/null || true)"
  if [ -n "$owner" ] && [ "$(stat -c %U "$gi" 2>/dev/null || true)" != "$owner" ]; then
    chown "$owner:$owner" "$gi" 2>/dev/null || true
  fi

  # No trailing newline would glue our first line onto the file's last line.
  if [ -s "$gi" ] && [ "$(tail -c1 "$gi" | wc -l)" -eq 0 ]; then
    printf '\n' >> "$gi" 2>/dev/null || { log "gitignore: NOT WRITABLE ($gi) — union skipped"; return 0; }
  fi

  while IFS= read -r line; do
    [ -z "$line" ] && continue
    grep -qxF -- "$line" "$gi" 2>/dev/null && continue
    gitignore_append "$gi" "$line" || return 0
  done <<< "$up"
  grep -qxF -- ".leonardo/instance.json" "$gi" 2>/dev/null \
    || gitignore_append "$gi" ".leonardo/instance.json" || return 0
  grep -qxF -- "$COMPOSE_FILE.pre-sync-*" "$gi" 2>/dev/null \
    || gitignore_append "$gi" "$COMPOSE_FILE.pre-sync-*" || return 0
}

# ---- pre-sync safety net: snapshot compose before the wholesale checkout ---
# The sync overwrites docker-compose.yml wholesale; any hand-edit the override
# migration missed stays recoverable on-box. Newest 3 snapshots are kept.
backup_compose() {
  [ -f "$PROJECT_DIR/$COMPOSE_FILE" ] || return 0
  local snap="$COMPOSE_FILE.pre-sync-$(date -u +%Y%m%d-%H%M%S)"
  if cp "$PROJECT_DIR/$COMPOSE_FILE" "$PROJECT_DIR/$snap" 2>>"$LOG"; then
    log "backup: snapshotted $COMPOSE_FILE -> $snap"
  else
    log "backup: WARN could not snapshot $COMPOSE_FILE (see $LOG)"
  fi
  ls -1t "$PROJECT_DIR/$COMPOSE_FILE".pre-sync-* 2>/dev/null | tail -n +4 | xargs -r rm -f
}

# ---- per-instance override file (never synced, seeded once if absent) ------
# docker compose auto-merges docker-compose.override.yml over the base file, so
# per-box config (extra mounts, mem limits, custom services) survives every
# wholesale compose sync. Deliberately NOT on the allowlist and NOT overwritten
# here — the whole point is that the client owns its contents. When seeded it
# joins SEEDED so the sync commit picks it up; called again post-sync as a
# fallback for boxes with no upstream remote (idempotent).
seed_override_file() {
  [ -e "$PROJECT_DIR/$OVERRIDE_FILE" ] && return 0
  cat > "$PROJECT_DIR/$OVERRIDE_FILE" <<'EOF'
# ✅ PER-INSTANCE OVERRIDES LIVE HERE — this file is yours; platform updates never touch it.
# docker compose merges it over docker-compose.yml automatically.
# Merge rules: single values (command, restart, mem_limit) REPLACE the base;
# maps (environment) merge per key; lists (volumes, ports) APPEND; you cannot remove base entries.
# New services defined here are added to the stack.
#
# Example:
# services:
#   llamapress:
#     volumes:
#       - ./rails/config/initializers/my_custom.rb:/rails/config/initializers/my_custom.rb
#     mem_limit: 1g
services: {}
EOF
  SEEDED+=("$OVERRIDE_FILE")
  log "seed: created $OVERRIDE_FILE (per-instance overrides; updates never touch it)"
}

# ---- one-shot seeding of client-overlay files (see OVERLAY_SEEDS) ----------
# Handles both FILE seeds (blob upstream) and DIRECTORY seeds (tree upstream).
# A dir seed fires when the local dir is missing OR empty — an empty dir is
# either docker's auto-created wedge or a bare default, and a path-scoped
# checkout only ADDS files there, it cannot clobber content that doesn't exist.
# A non-empty local dir is client-owned and never touched.
SEEDED=()
seed_overlay_files() { # $1 ref
  local ref="$1" p dst typ
  SEEDED=()
  for p in "${OVERLAY_SEEDS[@]}"; do
    dst="$PROJECT_DIR/$p"
    typ="$(git -C "$PROJECT_DIR" cat-file -t "$ref:$p" 2>/dev/null)" || typ=""

    if [ "$typ" = "tree" ]; then
      if [ -e "$dst" ] && [ ! -d "$dst" ]; then
        log "seed: ERROR $p is a file where a directory belongs — fix manually: rm '$p' && bash bin/update --sync-only"
        continue
      fi
      if [ -d "$dst" ] && [ -n "$(ls -A "$dst" 2>/dev/null)" ]; then
        continue  # non-empty -> client-owned, never overwrite
      fi
      rmdir "$dst" 2>/dev/null || true  # clear a root-owned empty wedge so checkout can recreate it user-owned
      if git -C "$PROJECT_DIR" checkout "$ref" -- "$p" 2>>"$LOG"; then
        log "seed: created dir $p from $ref (client-owned from now on, never overwritten)"
        SEEDED+=("$p")
      else
        log "seed: WARN failed to checkout dir $p (see $LOG)"
      fi
      continue
    fi

    # file seed (blob upstream, or absent upstream — placehold_missing_mounts backstops that)
    if [ -d "$dst" ]; then
      # docker's missing-bind-source footgun: an empty root-owned dir where a file belongs
      if rmdir "$dst" 2>>"$LOG"; then
        log "seed: healed docker's empty-directory wedge at $p"
      else
        log "seed: ERROR $p is a non-empty directory where a file belongs — fix manually: sudo rm -r '$p' && bash bin/update --sync-only"
        continue
      fi
    fi
    [ -e "$dst" ] && continue
    if [ -n "$typ" ]; then
      mkdir -p "$(dirname "$dst")" 2>>"$LOG" || true
      if git -C "$PROJECT_DIR" show "$ref:$p" > "$dst" 2>>"$LOG"; then
        log "seed: created $p from $ref (client-owned from now on, never overwritten)"
        SEEDED+=("$p")
      else
        log "seed: WARN failed to write $p (see $LOG)"
      fi
    else
      log "seed: WARN $p missing locally and absent in $ref — placeholder will be created if compose mounts it"
    fi
  done
}

# ---- last-resort placeholders: never let docker invent a mount source ------
# After seeding, any bind source still missing (absent upstream, no network,
# future compose additions) gets a minimal USER-owned placeholder. Left alone,
# docker auto-creates a ROOT-owned empty directory instead: file mounts then
# crashloop ("not a directory" from runc) and dir mounts shadow the image's
# content. Type is inferred from the path (an extension => file; content-aware:
# {} for .json since an empty file is invalid JSON; otherwise an empty dir).
# Logs a loud WARN — the stack stays bootable, but real content should follow.
placehold_missing_mounts() {
  local src dst base f
  for f in "$COMPOSE_FILE" "$OVERRIDE_FILE"; do
    [ -f "$PROJECT_DIR/$f" ] || continue
    while IFS= read -r src; do
      dst="$PROJECT_DIR/$src"
      [ -e "$dst" ] && continue
      mkdir -p "$(dirname "$dst")" 2>>"$LOG" || true
      case "${src##*/}" in
        ?*.*)  # basename has an extension -> file mount
          case "$src" in
            *.json) printf '{}\n' > "$dst" 2>>"$LOG" ;;
            *) printf '# Placeholder created by bin/update: %s was missing at update time.\n# Replace with real content (a platform sync may reseed it: bash bin/update --sync-only).\n' "$src" > "$dst" 2>>"$LOG" ;;
          esac
          [ -f "$dst" ] && log "placehold: WARN created placeholder FILE $src — was missing, docker would have wedged it into a directory" ;;
        *)     # no extension -> directory mount
          mkdir -p "$dst" 2>>"$LOG"
          [ -d "$dst" ] && log "placehold: WARN created placeholder DIR $src — was missing, docker would have created it root-owned" ;;
      esac
    done < <(sed -nE 's|^[[:space:]]*-[[:space:]]*"?\./([^:"]+)"?:.*|\1|p' "$PROJECT_DIR/$f")
  done
}

# ---- preflight: refuse to act on a compose whose bind sources are missing ---
# Docker silently creates a missing bind-mount source as a root-owned directory; for file
# mounts that permanently wedges the container ("not a directory" from runc) until someone
# deletes the directory by hand. Fail LOUD before docker ever sees the compose instead.
# Covers the override file too — plain `docker compose` merges it, so its binds count.
preflight_compose() {
  [ -f "$PROJECT_DIR/$COMPOSE_FILE" ] || return 0
  local bad=0 src p f
  for f in "$COMPOSE_FILE" "$OVERRIDE_FILE"; do
    [ -f "$PROJECT_DIR/$f" ] || continue
    while IFS= read -r src; do
      [ -e "$PROJECT_DIR/$src" ] \
        || { log "preflight: ERROR $f bind-mounts ./$src but it does not exist on the host"; bad=1; }
    done < <(sed -nE 's|^[[:space:]]*-[[:space:]]*"?\./([^:"]+)"?:.*|\1|p' "$PROJECT_DIR/$f")
  done
  for p in "${OVERLAY_SEEDS[@]}"; do
    case "${p##*/}" in
      ?*.*)  # extension => a FILE seed; a directory there is docker's missing-bind-source wedge
        [ -d "$PROJECT_DIR/$p" ] \
          && { log "preflight: ERROR $p is a directory where a file belongs (docker missing-bind-source wedge)"; bad=1; } ;;
    esac
  done
  return "$bad"
}

sync_from_upstream() {
  command -v git >/dev/null 2>&1 || { log "sync: git not found — skipping"; return 0; }
  # MUST come before the first git command in $PROJECT_DIR. Fleet checkouts are often owned by
  # a different uid than the caller; git then refuses EVERY command there with "dubious
  # ownership", the probe below reads that as "not a git repo", and the whole sync silently
  # skips — the box takes new images while its platform code stays frozen.
  git config --global --add safe.directory "$PROJECT_DIR" 2>/dev/null || true
  git -C "$PROJECT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || { log "sync: not a git repo — skipping"; return 0; }
  git -C "$PROJECT_DIR" remote get-url "$UPSTREAM_REMOTE" >/dev/null 2>&1 \
    || { log "sync: no '$UPSTREAM_REMOTE' remote — skipping (this IS upstream?)"; return 0; }

  log "sync: fetching $UPSTREAM_REMOTE/$UPSTREAM_BRANCH ..."
  if ! git -C "$PROJECT_DIR" fetch --quiet "$UPSTREAM_REMOTE" "$UPSTREAM_BRANCH" 2>>"$LOG"; then
    log "sync: WARN git fetch failed — skipping sync (image swap continues)"
    return 0
  fi
  local ref="$UPSTREAM_REMOTE/$UPSTREAM_BRANCH" sha
  git -C "$PROJECT_DIR" rev-parse --verify --quiet "$ref" >/dev/null \
    || { log "sync: WARN $ref missing — skipping"; return 0; }
  sha="$(git -C "$PROJECT_DIR" rev-parse --short "$ref")"

  # 1) pull allowlisted paths that actually exist in upstream (overwrite wholesale) —
  #    snapshotting the compose file first so a clobbered hand-edit stays recoverable
  backup_compose
  local compose_before=""
  [ -f "$PROJECT_DIR/$COMPOSE_FILE" ] \
    && compose_before="$(git -C "$PROJECT_DIR" hash-object "$COMPOSE_FILE" 2>/dev/null)"
  local p present=()
  for p in "${ALLOWLIST[@]}"; do
    if git -C "$PROJECT_DIR" cat-file -e "$ref:$p" 2>/dev/null; then present+=("$p")
    else log "sync: allowlist '$p' absent in $ref — skipping"; fi
  done
  if [ "${#present[@]}" -gt 0 ]; then
    if git -C "$PROJECT_DIR" checkout "$ref" -- "${present[@]}" 2>>"$LOG"; then
      log "sync: pulled from $ref: ${present[*]}"
    else
      log "sync: WARN checkout had issues (see $LOG)"
    fi
  fi
  # A changed compose can carry non-image config (mounts, env, log rotation) that only a
  # container recreate applies — the main flow widens the restart to a full `up -d` on this.
  local compose_after=""
  [ -f "$PROJECT_DIR/$COMPOSE_FILE" ] \
    && compose_after="$(git -C "$PROJECT_DIR" hash-object "$COMPOSE_FILE" 2>/dev/null)"
  if [ "$compose_before" != "$compose_after" ]; then
    COMPOSE_SYNC_CHANGED=1
    log "sync: $COMPOSE_FILE changed — all services will be recreated"
  fi

  # 1b) seed client-overlay files the fresh compose may bind-mount (one-shot, never overwrites),
  #     plus the per-instance override file — inside the sync so the commit includes them
  seed_overlay_files "$ref"
  seed_override_file

  # 2) .gitignore UNION-merged (never overwritten); 3) instance.json force-untracked
  ensure_gitignore_union "$ref"
  git -C "$PROJECT_DIR" rm -r --cached --ignore-unmatch -- ".leonardo/instance.json" >/dev/null 2>&1 || true

  # 4) commit the sync — scoped, and only if no UNRELATED staged work is present
  git -C "$PROJECT_DIR" add -- "${present[@]}" "${SEEDED[@]}" ".gitignore" 2>/dev/null || true
  local f extra=0 nstaged=0
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    nstaged=$((nstaged + 1))
    [[ "$f" =~ $SYNC_COMMIT_RE ]] || { extra=1; log "sync: unrelated staged change: $f"; }
  done < <(git -C "$PROJECT_DIR" diff --cached --name-only 2>/dev/null)

  if [ "$nstaged" -eq 0 ]; then
    log "sync: already up to date ($sha) — nothing to commit"
  elif [ "$extra" -eq 1 ]; then
    log "sync: WARN unrelated staged changes present — left sync staged, NOT committing"
  elif git -C "$PROJECT_DIR" commit --quiet -m "chore(platform-sync): allowlist <- $ref ($sha)" 2>>"$LOG"; then
    log "sync: committed platform-sync ($sha)"
  else
    log "sync: WARN commit failed (see $LOG)"
  fi
}

# ---- run any pending migrations the sync just delivered --------------------
# The allowlist includes rails/db/migrate, so a sync can drop NEW platform
# migrations onto the box. Rails then blocks EVERY request with
# PendingMigrationError until they're applied — so we run db:migrate inside the
# llamapress container after every sync. Idempotent (a no-op when nothing is
# pending).
#
# We never gate on a single-shot `ps | grep` — a transient miss during container
# recreation is enough to skip the migrate and cause PendingMigrationError 500s.
# Instead we poll exec-readiness and retry db:migrate, then fail LOUD so the
# error is visible rather than silently swallowed.
#
# MIGRATE_MAX_RETRIES / MIGRATE_RETRY_SLEEP_SEC may be overridden for tests.
run_pending_migrations() {
  local DCM i
  local max_retries="${MIGRATE_MAX_RETRIES:-12}"
  local retry_sleep="${MIGRATE_RETRY_SLEEP_SEC:-5}"
  if docker compose version >/dev/null 2>&1; then DCM="docker compose"
  elif command -v docker-compose >/dev/null 2>&1; then DCM="docker-compose"
  else log "migrate: docker compose not found — skipping"; return 0; fi

  for i in $(seq 1 "$max_retries"); do
    if $DCM exec -T llamapress true >/dev/null 2>&1; then
      log "migrate: applying any pending migrations in llamapress (attempt $i) ..."
      if $DCM exec -T llamapress bin/rails db:migrate >>"$LOG" 2>&1; then
        log "migrate: db:migrate ok"; return 0
      fi
      log "migrate: WARN db:migrate attempt $i failed — retrying"
    else
      log "migrate: llamapress not exec-ready (attempt $i/$max_retries) — waiting"
    fi
    sleep "$retry_sleep"
  done
  log "migrate: ERROR could not apply migrations after $max_retries attempts — app may 500 (PendingMigrationError); run '$DCM exec -T llamapress bin/rails db:migrate' manually"
  return 1
}

# ---- --sync-only fast path (no image swap, no version args needed) ---------
if [ "${1:-}" = "--sync-only" ]; then
  log "=== bin/update --sync-only ==="
  sync_rc=0
  sync_from_upstream
  seed_override_file
  placehold_missing_mounts
  preflight_compose || sync_rc=1
  run_pending_migrations || sync_rc=1
  log "=== bin/update --sync-only done ==="
  exit "$sync_rc"
fi

# ---- validate -------------------------------------------------------------
[ -n "$LLAMABOT_TARGET" ] && [ -n "$LLAMAPRESS_TARGET" ] \
  || fail "usage: bin/update <llamabot_version> <llamapress_version>"
[[ "$LLAMABOT_TARGET"   =~ $VERSION_RE ]] || fail "invalid llamabot version: $LLAMABOT_TARGET"
[[ "$LLAMAPRESS_TARGET" =~ $VERSION_RE ]] || fail "invalid llamapress version: $LLAMAPRESS_TARGET"

if docker compose version >/dev/null 2>&1; then DC="docker compose"; else DC="docker-compose"; fi

# Effective current version for an image: prefer a .env override, else the
# compose default (${VAR:-default}) or the literal tag.
current_version() { # $1 var_name  $2 image_prefix
  local var="$1" prefix="$2" v="" line
  if [ -f "$ENV_FILE" ]; then
    v="$(grep -E "^${var}=" "$ENV_FILE" 2>/dev/null | tail -n1 | sed -E 's/^[^=]+=//; s/[[:space:]"]//g')"
  fi
  if [ -z "$v" ]; then
    line="$(grep -E "image:.*${prefix}" "$COMPOSE_FILE" | head -n1)"
    if echo "$line" | grep -q "\${${var}"; then
      v="$(echo "$line" | sed -nE "s/.*\\\$\\{${var}:-([^}]+)\\}.*/\\1/p")"
    else
      v="$(echo "$line" | sed -nE "s#.*${prefix}([0-9A-Za-z._-]+).*#\\1#p")"
    fi
  fi
  echo "$v"
}

set_env_var() { # $1 var  $2 value  — replace-or-append in .env
  touch "$ENV_FILE"
  local tmp; tmp="$(mktemp)"
  grep -vE "^$1=" "$ENV_FILE" > "$tmp" 2>/dev/null || true
  echo "$1=$2" >> "$tmp"
  cat "$tmp" > "$ENV_FILE"
  rm -f "$tmp"
}

apply_one() { # $1 service  $2 env_var  $3 image_prefix  $4 target
  local svc="$1" var="$2" prefix="$3" target="$4" cur line
  grep -qE "image:.*${prefix}" "$COMPOSE_FILE" || { log "skip $svc: $prefix not in compose"; return; }
  cur="$(current_version "$var" "$prefix")"
  if [ "$cur" = "$target" ]; then
    # The file matching the target is NOT proof the box is current: the sync may have just
    # pulled an upstream compose already carrying the target tags while the containers still
    # run old images. Trust the RUNNING container, not the file.
    local cid running=""
    cid="$($DC ps -q "$svc" 2>/dev/null | head -n1)"
    [ -n "$cid" ] && running="$(docker inspect --format '{{.Config.Image}}' "$cid" 2>/dev/null)"
    if [ -n "$running" ] && [ "$running" != "${prefix}${target}" ]; then
      log "$svc: file already at $target but container runs $running — updating"
      CHANGED+=("$svc")
    else
      log "$svc already at $target — no change"
    fi
    return
  fi
  log "$svc: ${cur:-unknown} -> $target"
  line="$(grep -E "image:.*${prefix}" "$COMPOSE_FILE" | head -n1)"
  if echo "$line" | grep -q "\${${var}"; then
    set_env_var "$var" "$target"
    log "$svc: set $var=$target in $ENV_FILE (.env mode)"
  else
    sed -i -E "s#(${prefix})[0-9A-Za-z._-]+#\\1${target}#" "$COMPOSE_FILE"
    log "$svc: rewrote image tag in $COMPOSE_FILE (literal mode)"
  fi
  CHANGED+=("$svc")
}

log "=== bin/update start (llamabot=$LLAMABOT_TARGET llamapress=$LLAMAPRESS_TARGET) ==="

# Pull the platform allowlist BEFORE setting versions. docker-compose.yml IS allowlisted,
# so the sync must land first: the fresh upstream compose is then stamped with the intended
# tags, not upstream's defaults. Corollary: the fresh compose may ALREADY carry the target
# tags, so apply_one compares against the running containers, never just the file.
sync_from_upstream
seed_override_file
placehold_missing_mounts
preflight_compose || fail "compose references missing bind-mount sources (see $LOG) — refusing to pull/restart"
run_pending_migrations

[ -f "$COMPOSE_FILE" ] || fail "no $COMPOSE_FILE in $PROJECT_DIR"

apply_one "llamabot"   "LLAMABOT_VERSION"   "kody06/llamabot:"          "$LLAMABOT_TARGET"
apply_one "llamapress" "LLAMAPRESS_VERSION" "kody06/llamapress-simple:" "$LLAMAPRESS_TARGET"

if [ "${#CHANGED[@]}" -eq 0 ] && [ "$COMPOSE_SYNC_CHANGED" -eq 0 ]; then
  log "nothing to update — already current"
  write_marker "noop" "already up to date"
  echo "Already up to date."
  exit 0
fi

# ---- pull (synchronous; pull does NOT recreate/kill containers) -----------
if [ "${#CHANGED[@]}" -gt 0 ]; then
  log "pulling: ${CHANGED[*]}"
  if ! $DC pull "${CHANGED[@]}" >>"$LOG" 2>&1; then
    fail "docker compose pull failed for: ${CHANGED[*]} (see $LOG)"
  fi
  log "pull ok"
fi

# ---- recreate DETACHED so we survive llamabot restarting its own container ----
# When the sync changed docker-compose.yml, recreate EVERYTHING (`up -d` with no service
# list) — compose only recreates services whose config actually changed, and this applies
# non-image changes too (new mounts, log rotation, env). Otherwise recreate only CHANGED.
if [ "$COMPOSE_SYNC_CHANGED" -eq 1 ]; then
  write_marker "restarting" "compose changed; recreating all services (images: ${CHANGED[*]:-none})"
  RESTART_CMD="cd $PROJECT_DIR && $DC up -d"
else
  write_marker "restarting" "images pulled; recreating ${CHANGED[*]:-}"
  RESTART_CMD="cd $PROJECT_DIR && $DC up -d ${CHANGED[*]:-}"
fi
if command -v systemd-run >/dev/null 2>&1; then
  UNIT="leonardo-update-$(date +%s)"
  if sudo systemd-run --no-block --unit="$UNIT" /bin/bash -c "$RESTART_CMD"; then
    log "recreate scheduled via systemd ($UNIT)"
  else
    log "systemd-run failed; falling back to nohup"
    nohup bash -c "$RESTART_CMD" >>"$LOG" 2>&1 &
  fi
else
  nohup bash -c "$RESTART_CMD" >>"$LOG" 2>&1 &
  log "recreate scheduled via nohup"
fi

write_marker "success" "updated ${CHANGED[*]:-config only}; restart scheduled"
log "=== bin/update done (changed: ${CHANGED[*]:-config only}) ==="
echo "Update initiated for: ${CHANGED[*]:-config only}. Containers restarting..."
exit 0
